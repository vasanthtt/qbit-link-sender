{
  "manifest_version": 3,
  "name": "Send to qBittorrent",
  "version": "0.2",
  "description": "Send magnet or torrent links to your qBittorrent",
  "icons": {
    "48": "icon48.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": { "default_popup": "options.html" },
  "options_page": "options.html"
}